#!/usr/bin/env bash
# post-merge — Warnt wenn Dateien durch den Merge geschrumpft sind.
#
# Installation: scripts/install-hooks.sh ausführen (symlinkt nach .git/hooks/)

set -euo pipefail

RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'

ORIG=${ORIG_HEAD:-}
if [[ -z "$ORIG" ]]; then
    # ORIG_HEAD wird von git merge gesetzt; beim ersten Checkout fehlt es.
    exit 0
fi

SHRUNK=()

# Alle Dateien die im Merge-Commit geändert wurden
while IFS= read -r file; do
    [[ -f "$file" ]] || continue

    before=$(git show "${ORIG}:${file}" 2>/dev/null | wc -l || echo 0)
    after=$(git show "HEAD:${file}"     2>/dev/null | wc -l || echo 0)

    lost=$(( before - after ))
    if (( lost > 4 )); then
        SHRUNK+=("$file (${before} → ${after} Zeilen, -${lost})")
    fi
done < <(git diff --name-only "${ORIG}..HEAD" 2>/dev/null)

if (( ${#SHRUNK[@]} == 0 )); then
    echo -e "${GREEN}[post-merge]${NC} Kein unerwarteter Inhaltsverlust."
    exit 0
fi

echo
echo -e "${RED}[post-merge] WARNUNG: Folgende Dateien haben Zeilen verloren:${NC}"
for entry in "${SHRUNK[@]}"; do
    echo -e "  ${YELLOW}!${NC}  $entry"
done
echo
echo -e "${YELLOW}Bitte prüfen:${NC}"
echo "  git diff ${ORIG}..HEAD -- <datei>"
echo
echo -e "${RED}NICHT pushen bevor der Verlust untersucht und für OK befunden wurde!${NC}"
echo
