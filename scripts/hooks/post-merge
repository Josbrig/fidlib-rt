#!/usr/bin/env bash
# post-merge — Warns when files have shrunk due to the merge.
#
# Installation: run scripts/install-hooks.sh (symlinks into .git/hooks/)

set -euo pipefail

RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'

ORIG=${ORIG_HEAD:-}
if [[ -z "$ORIG" ]]; then
    # ORIG_HEAD is set by git merge; missing on first checkout.
    exit 0
fi

SHRUNK=()

# All files changed in the merge commit
while IFS= read -r file; do
    [[ -f "$file" ]] || continue

    before=$(git show "${ORIG}:${file}" 2>/dev/null | wc -l || echo 0)
    after=$(git show "HEAD:${file}"     2>/dev/null | wc -l || echo 0)

    lost=$(( before - after ))
    if (( lost > 4 )); then
        SHRUNK+=("$file (${before} → ${after} lines, -${lost})")
    fi
done < <(git diff --name-only "${ORIG}..HEAD" 2>/dev/null)

if (( ${#SHRUNK[@]} == 0 )); then
    echo -e "${GREEN}[post-merge]${NC} No unexpected content loss."
    exit 0
fi

echo
echo -e "${RED}[post-merge] WARNING: The following files lost lines:${NC}"
for entry in "${SHRUNK[@]}"; do
    echo -e "  ${YELLOW}!${NC}  $entry"
done
echo
echo -e "${YELLOW}Please check:${NC}"
echo "  git diff ${ORIG}..HEAD -- <file>"
echo
echo -e "${RED}DO NOT push until the loss has been investigated and confirmed OK!${NC}"
echo
